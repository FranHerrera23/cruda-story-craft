# CTD Podcast Automation - Environment Variables
# Copy this file to .env and fill in your values

# ===========================================
# GOOGLE CLOUD CONFIGURATION
# ===========================================

# Path to your Google Cloud service account JSON key file
# Download from: Google Cloud Console > IAM & Admin > Service Accounts
GOOGLE_APPLICATION_CREDENTIALS=./credentials/google-service-account.json

# Google Drive folder IDs (get from URL when viewing folder)
# Format: https://drive.google.com/drive/folders/{FOLDER_ID}
GOOGLE_DRIVE_CLIPS_FOLDER_ID=your_clips_folder_id
GOOGLE_DRIVE_ARCHIVE_FOLDER_ID=your_archive_folder_id

# Google Sheets ID (get from URL when viewing sheet)
# Format: https://docs.google.com/spreadsheets/d/{SHEET_ID}/edit
GOOGLE_SHEETS_ID=your_google_sheets_id
GOOGLE_SHEETS_TAB_NAME=CTD Content Tracker

# ===========================================
# ANTHROPIC (CLAUDE) CONFIGURATION
# ===========================================

# Your Anthropic API key for caption generation
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-api-key

# Model to use for caption generation
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ===========================================
# OPTIONAL CONFIGURATION
# ===========================================

# Local directory for temporary video processing
# Defaults to ./temp if not set
TEMP_DIRECTORY=./temp

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Enable/disable notifications (future feature)
ENABLE_NOTIFICATIONS=false

# Slack webhook URL for notifications (optional)
SLACK_WEBHOOK_URL=

# Email for notifications (optional)
NOTIFICATION_EMAIL=
