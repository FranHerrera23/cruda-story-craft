{
  "name": "ctd-podcast-automation",
  "version": "1.0.0",
  "description": "CTD Podcast Social Media Automation System - Analyzes video clips and generates platform-specific captions",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ctd-podcast": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/cli/index.ts",
    "start": "node dist/cli/index.js",
    "process-clips": "tsx src/cli/index.ts process-clips",
    "process-clip": "tsx src/cli/index.ts process-clip",
    "regenerate": "tsx src/cli/index.ts regenerate",
    "watch": "tsx src/cli/index.ts watch",
    "setup": "tsx src/cli/index.ts setup",
    "lint": "eslint src/**/*.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google-cloud/speech": "^6.0.0",
    "@googleapis/drive": "^8.0.0",
    "@googleapis/sheets": "^6.0.0",
    "anthropic": "^0.30.0",
    "chalk": "^5.3.0",
    "chokidar": "^3.5.3",
    "commander": "^12.0.0",
    "dotenv": "^16.3.1",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.2",
    "googleapis": "^130.0.0",
    "mime-types": "^2.1.35",
    "ora": "^8.0.1",
    "p-queue": "^8.0.1",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.24",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^20.10.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "podcast",
    "automation",
    "social-media",
    "content-generation",
    "caption-generator"
  ],
  "author": "CRUDA",
  "license": "MIT"
}
